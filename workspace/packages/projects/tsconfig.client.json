{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "react",
      "react-dom"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
