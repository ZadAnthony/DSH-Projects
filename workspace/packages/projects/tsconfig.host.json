{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024"
    ]
  },
  "include": [
    "src/*.ts",
    "src/communication/**/*.ts",
    "src/features/**/*.ts",
    "src/memory-bot/**/*.ts",
    "src/continuity/**/*.ts"
  ],
  "exclude": [
    "src/client",
    "src/features/**/client.ts"
  ]
}
